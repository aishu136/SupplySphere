# AWS credentials are read from the standard chain (env vars, ~/.aws, instance/role credentials).
AWS_REGION=us-east-1
# Use a cross-region inference profile (e.g. us.anthropic.claude-opus-5) if your account requires one.
BEDROCK_MODEL_ID=anthropic.claude-opus-5
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

SCM_API_URL=http://localhost:8080
SCM_MCP_URL=http://localhost:8001/mcp

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Computer vision: any Ultralytics weights. For damage detection, train a model whose class
# names include e.g. "damaged", "dent", "tear", "crushed", "wet" and point this at it.
YOLO_MODEL=yolo11n.pt
VISION_CONFIDENCE=0.35
