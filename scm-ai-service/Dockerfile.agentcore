# Image for Amazon Bedrock AgentCore Runtime (ARM64, serves /invocations and /ping on port 8080).
# Only the agent runs here; the MCP server is reached at SCM_MCP_URL.
FROM --platform=linux/arm64 python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir \
    "langchain>=1.0,<2" "langchain-aws>=1.0" "langchain-mcp-adapters>=0.1.9" "langgraph>=1.0" \
    "mcp>=1.12" "bedrock-agentcore>=0.1.2" "pydantic-settings>=2.4" "httpx>=0.27" boto3

COPY app/__init__.py app/config.py app/llm.py app/agent.py app/agentcore_app.py ./app/

ENV AWS_REGION=us-east-1
EXPOSE 8080
CMD ["python", "-m", "app.agentcore_app"]
